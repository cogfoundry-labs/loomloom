{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loomloom.dev/schemas/template-spec-v1.json",
  "type": "object",
  "required": ["meta", "steps", "inputSchema"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "scenario": {"type": "string"},
        "inputSummary": {"type": "string"},
        "displayOutputType": {"type": "string"},
        "primaryOutputType": {"type": "string"},
        "tags": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/step"}
    },
    "inputSchema": {"$ref": "#/$defs/inputSchema"},
    "fieldBindings": {"type": "array", "items": {"$ref": "#/$defs/fieldBinding"}},
    "paramBindings": {"type": "array", "items": {"$ref": "#/$defs/paramBinding"}}
  },
  "$defs": {
    "step": {
      "type": "object",
      "required": ["stepId", "displayName", "executionUnit"],
      "additionalProperties": false,
      "properties": {
        "stepId": {"type": "string", "pattern": "^stp_[a-z0-9]{6,10}$"},
        "displayName": {"type": "string", "minLength": 1},
        "executionUnit": {"type": "string", "minLength": 1},
        "instruction": {"type": "string"},
        "dependsOn": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "upstreamBindings": {"type": "array", "items": {"$ref": "#/$defs/upstreamBinding"}},
        "triggerPolicy": {"enum": ["require_all", "allow_partial", "fail_fast"]},
        "defaultModelRef": {
          "type": "object",
          "required": ["modelKey"],
          "additionalProperties": false,
          "properties": {"modelKey": {"type": "string", "minLength": 1}}
        },
        "allowModelOverride": {"type": "boolean"},
        "staticParams": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "upstreamBinding": {
      "type": "object",
      "required": ["inputPort"],
      "additionalProperties": false,
      "properties": {
        "inputPort": {"type": "string", "minLength": 1},
        "sourceType": {"enum": ["step_output", "initial_input"]},
        "sourceStepId": {"type": "string"},
        "sourcePort": {"type": "string"},
        "sourceInputKey": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"sourceType": {"const": "initial_input"}}, "required": ["sourceType"]},
          "then": {"required": ["sourceInputKey"]}
        },
        {
          "if": {"anyOf": [{"properties": {"sourceType": {"const": "step_output"}}, "required": ["sourceType"]}, {"not": {"required": ["sourceType"]}}]},
          "then": {"required": ["sourceStepId", "sourcePort"]}
        }
      ]
    },
    "inputSchema": {
      "type": "object",
      "required": ["fields"],
      "additionalProperties": false,
      "properties": {
        "fields": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/inputField"}},
        "instructions": {"type": "array", "items": {"type": "string"}},
        "sampleRows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["values"],
            "additionalProperties": false,
            "properties": {"values": {"type": "object", "additionalProperties": {"type": "string"}}}
          }
        }
      }
    },
    "fieldPresentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "widget": {"enum": ["input", "textarea", "select"]},
        "placeholder": {"type": "string"},
        "hint": {"type": "string"},
        "examples": {"type": "array", "items": {"type": "string"}}
      }
    },
    "inputField": {
      "type": "object",
      "required": ["key", "label", "valueType"],
      "additionalProperties": false,
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "required": {"type": "boolean"},
        "valueType": {"enum": ["string", "enum", "image_url", "asset_ref", "text_reference"]},
        "enumValues": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "acceptedMimeTypes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "multiValue": {"type": "boolean"},
        "maxValues": {"type": "integer", "minimum": 1},
        "order": {"type": "integer"},
        "defaultValue": {"type": "string"},
        "hidden": {"type": "boolean"},
        "sourceKind": {"enum": ["user_input", "default_value", "hidden"]},
        "presentation": {"$ref": "#/$defs/fieldPresentation"}
      },
      "allOf": [
        {"if": {"properties": {"valueType": {"const": "enum"}}}, "then": {"required": ["enumValues"]}},
        {"if": {"properties": {"valueType": {"enum": ["asset_ref", "text_reference"]}}}, "then": {"required": ["acceptedMimeTypes"]}},
        {"if": {"properties": {"multiValue": {"const": true}}, "required": ["multiValue"]}, "then": {"required": ["maxValues"]}}
      ]
    },
    "fieldBinding": {
      "type": "object",
      "required": ["fieldKey", "stepId", "paramKey", "bindMode"],
      "additionalProperties": false,
      "properties": {
        "fieldKey": {"type": "string"},
        "stepId": {"type": "string"},
        "paramKey": {"type": "string"},
        "bindMode": {"enum": ["shared", "expanded"]}
      }
    },
    "paramBinding": {
      "type": "object",
      "required": ["stepId", "paramKey", "bindMode", "sources"],
      "additionalProperties": false,
      "properties": {
        "stepId": {"type": "string"},
        "paramKey": {"type": "string"},
        "bindMode": {"enum": ["shared", "expanded"]},
        "separator": {"type": "string"},
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["kind"],
            "additionalProperties": false,
            "properties": {
              "kind": {"enum": ["field_ref", "literal"]},
              "fieldKey": {"type": "string"},
              "literal": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
