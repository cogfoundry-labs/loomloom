{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loomloom.dev/schemas/template-spec-v2.json",
  "title": "LoomLoom TemplateSpec v2",
  "type": "object",
  "required": ["meta", "steps", "workbook"],
  "additionalProperties": false,
  "properties": {
    "meta": {"$ref": "#/$defs/meta"},
    "templateInputs": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][A-Za-z0-9_]{0,63}$"},
      "additionalProperties": {"$ref": "#/$defs/templateInput"}
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/step"}
    },
    "workbook": {"$ref": "#/$defs/workbook"}
  },
  "$defs": {
    "identity": {"type": "string", "pattern": "^[a-z][A-Za-z0-9_]{0,63}$"},
    "stepId": {"type": "string", "pattern": "^stp_[a-z0-9]{6,10}$"},
    "jsonValue": {},
    "meta": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "scenario": {"type": "string"},
        "inputSummary": {"type": "string"},
        "displayOutputType": {"type": "string"},
        "primaryOutputType": {"type": "string"},
        "tags": {"type": "array", "items": {"type": "string"}}
      }
    },
    "presentation": {
      "type": "object",
      "required": ["label", "order"],
      "additionalProperties": false,
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "widget": {"type": "string"},
        "placeholder": {"type": "string"},
        "hint": {"type": "string"},
        "examples": {"type": "array", "items": {"type": "string"}},
        "order": {"type": "integer"}
      }
    },
    "templateInput": {
      "oneOf": [
        {"$ref": "#/$defs/valueInput"},
        {"$ref": "#/$defs/artifactInput"}
      ]
    },
    "valueInput": {
      "type": "object",
      "required": ["kind", "valueType", "blankPolicy", "presentation"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "value"},
        "valueType": {"enum": ["string", "number", "integer", "boolean", "array", "object"]},
        "required": {"type": "boolean"},
        "blankPolicy": {"enum": ["error", "omit"]},
        "constraints": {"type": "object"},
        "defaultValue": {"$ref": "#/$defs/jsonValue"},
        "presentation": {"$ref": "#/$defs/presentation"}
      },
      "allOf": [
        {
          "if": {"properties": {"required": {"const": true}}, "required": ["required"]},
          "then": {"properties": {"blankPolicy": {"const": "error"}}},
          "else": {"properties": {"blankPolicy": {"const": "omit"}}}
        }
      ]
    },
    "artifactInput": {
      "type": "object",
      "required": ["kind", "blankPolicy", "acceptedMimeTypes", "maxItems", "presentation"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "artifact"},
        "required": {"type": "boolean"},
        "blankPolicy": {"enum": ["error", "omit"]},
        "acceptedMimeTypes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[^/]+/[^/]+$"}
        },
        "minItems": {"type": "integer", "minimum": 0},
        "maxItems": {"type": "integer", "minimum": 1},
        "presentation": {"$ref": "#/$defs/presentation"}
      },
      "allOf": [
        {
          "if": {"properties": {"required": {"const": true}}, "required": ["required"]},
          "then": {"properties": {"blankPolicy": {"const": "error"}}},
          "else": {"properties": {"blankPolicy": {"const": "omit"}}}
        }
      ]
    },
    "step": {
      "type": "object",
      "required": [
        "stepId",
        "displayName",
        "executionBinding"
      ],
      "additionalProperties": false,
      "properties": {
        "stepId": {
          "$ref": "#/$defs/stepId"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stepId"
          },
          "uniqueItems": true
        },
        "triggerPolicy": {
          "enum": [
            "require_all",
            "allow_partial",
            "fail_fast"
          ]
        },
        "when": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stepId",
            "portId",
            "equals"
          ],
          "properties": {
            "stepId": {
              "$ref": "#/$defs/stepId"
            },
            "portId": {
              "$ref": "#/$defs/identity"
            },
            "equals": {
              "type": "boolean"
            }
          }
        },
        "executionBinding": {
          "$ref": "#/$defs/executionBinding"
        },
        "modelSelection": {
          "$ref": "#/$defs/modelSelection"
        },
        "inputBindings": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identity"
          },
          "additionalProperties": {
            "$ref": "#/$defs/inputBinding"
          }
        },
        "code": {
          "$ref": "#/$defs/code"
        },
        "loop": {
          "$ref": "#/$defs/loop"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "executionBinding": {
                "properties": {
                  "kind": {
                    "const": "codeProfile"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            },
            "required": [
              "executionBinding"
            ]
          },
          "then": {
            "properties": {
              "loop": false,
              "modelSelection": false
            },
            "required": [
              "code"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "executionBinding": {
                "properties": {
                  "kind": {
                    "const": "loop"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            },
            "required": [
              "executionBinding"
            ]
          },
          "then": {
            "properties": {
              "code": false,
              "modelSelection": false,
              "inputBindings": false,
              "when": false,
              "triggerPolicy": {
                "const": "require_all"
              }
            },
            "required": [
              "loop"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "executionBinding": {
                "properties": {
                  "kind": {
                    "const": "fixedModelContract"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            },
            "required": [
              "executionBinding"
            ]
          },
          "then": {
            "properties": {
              "code": false,
              "loop": false,
              "modelSelection": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "executionBinding": {
                "properties": {
                  "kind": {
                    "const": "capabilityProfile"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            },
            "required": [
              "executionBinding"
            ]
          },
          "then": {
            "properties": {
              "code": false,
              "loop": false
            },
            "required": [
              "modelSelection"
            ]
          }
        }
      ]
    },
    "executionBinding": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "subjectRevisionId"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "fixedModelContract"
            },
            "subjectRevisionId": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "profileId"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "capabilityProfile"
            },
            "profileId": {
              "type": "string",
              "minLength": 1
            },
            "profileRevision": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "profileId",
            "profileRevision"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "codeProfile"
            },
            "profileId": {
              "type": "string",
              "minLength": 1
            },
            "profileRevision": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "loop"
            }
          }
        }
      ]
    },
    "modelSelection": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "source",
            "defaultModelId"
          ],
          "additionalProperties": false,
          "properties": {
            "source": {
              "const": "fixed"
            },
            "inputKey": {
              "const": ""
            },
            "defaultModelId": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "source",
            "inputKey",
            "defaultModelId"
          ],
          "additionalProperties": false,
          "properties": {
            "source": {
              "const": "templateInput"
            },
            "inputKey": {
              "$ref": "#/$defs/identity"
            },
            "defaultModelId": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "inputBinding": {
      "oneOf": [
        {"$ref": "#/$defs/templateInputBinding"},
        {"$ref": "#/$defs/stepOutputBinding"},
        {"$ref": "#/$defs/literalBinding"},
        {"$ref": "#/$defs/platformContextBinding"},
        {"$ref": "#/$defs/composeBinding"},
        {"$ref": "#/$defs/sequenceBinding"},
        {"$ref": "#/$defs/mergeBinding"}
      ]
    },
    "templateInputBinding": {
      "type": "object",
      "required": ["source", "inputKey"],
      "additionalProperties": false,
      "properties": {
        "source": {"const": "templateInput"},
        "inputKey": {"$ref": "#/$defs/identity"},
        "fallbackValue": {"$ref": "#/$defs/jsonValue"}
      }
    },
    "stepOutputBinding": {
      "type": "object",
      "required": [
        "source",
        "stepId",
        "portId"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "const": "stepOutput"
        },
        "stepId": {
          "$ref": "#/$defs/stepId"
        },
        "portId": {
          "$ref": "#/$defs/identity"
        },
        "valueType": {
          "const": "string"
        }
      }
    },
    "literalBinding": {
      "type": "object",
      "required": ["source", "value"],
      "additionalProperties": false,
      "properties": {
        "source": {"const": "literal"},
        "value": {"$ref": "#/$defs/jsonValue"}
      }
    },
    "platformContextBinding": {
      "type": "object",
      "required": ["source", "contextKey"],
      "additionalProperties": false,
      "properties": {
        "source": {"const": "platformContext"},
        "contextKey": {"type": "string", "minLength": 1}
      }
    },
    "composeBinding": {
      "type": "object",
      "required": ["source", "compose"],
      "additionalProperties": false,
      "properties": {
        "source": {"const": "composeValue"},
        "compose": {"$ref": "#/$defs/composition"},
        "fallbackValue": {"$ref": "#/$defs/jsonValue"}
      }
    },
    "composition": {
      "type": "object",
      "required": ["kind", "parts"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "concat"},
        "separator": {"type": "string"},
        "parts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/compositionPart"}}
      }
    },
    "compositionPart": {
      "oneOf": [
        {
          "type": "object",
          "required": ["source", "inputKey"],
          "additionalProperties": false,
          "properties": {"source": {"const": "templateInput"}, "inputKey": {"$ref": "#/$defs/identity"}}
        },
        {
          "type": "object",
          "required": ["source", "literal"],
          "additionalProperties": false,
          "properties": {"source": {"const": "literal"}, "literal": {"type": "string", "minLength": 1}}
        }
      ]
    },
    "sequenceBinding": {
      "type": "object",
      "required": ["source", "sequence"],
      "additionalProperties": false,
      "properties": {
        "source": {"const": "sequence"},
        "sequence": {
          "type": "object",
          "required": ["items"],
          "additionalProperties": false,
          "properties": {
            "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sequenceItem"}}
          }
        }
      }
    },
    "sequenceItem": {
      "type": "object",
      "required": ["position", "kind", "source"],
      "additionalProperties": false,
      "properties": {
        "position": {"type": "integer", "minimum": 0},
        "kind": {"enum": ["text", "image", "video", "audio"]},
        "role": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/sequenceItemSource"}
      }
    },
    "sequenceItemSource": {
      "oneOf": [
        {
          "type": "object",
          "required": ["source", "inputKey"],
          "additionalProperties": false,
          "properties": {"source": {"const": "templateInput"}, "inputKey": {"$ref": "#/$defs/identity"}}
        },
        {
          "type": "object",
          "required": ["source", "stepId", "portId"],
          "additionalProperties": false,
          "properties": {"source": {"const": "stepOutput"}, "stepId": {"$ref": "#/$defs/stepId"}, "portId": {"$ref": "#/$defs/identity"}}
        },
        {
          "type": "object",
          "required": ["source", "value"],
          "additionalProperties": false,
          "properties": {"source": {"const": "literal"}, "value": {"$ref": "#/$defs/jsonValue"}}
        }
      ]
    },
    "mergeBinding": {
      "type": "object",
      "required": ["source", "merge"],
      "additionalProperties": false,
      "properties": {
        "source": {"const": "merge"},
        "merge": {
          "type": "object",
          "required": ["policy", "missingSourcePolicy", "sources"],
          "additionalProperties": false,
          "properties": {
            "policy": {"enum": ["ordered_artifacts", "concat_text"]},
            "missingSourcePolicy": {"enum": ["error", "omit"]},
            "sources": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/mergeSource"}}
          }
        }
      }
    },
    "mergeSource": {
      "oneOf": [
        {
          "type": "object",
          "required": ["source", "inputKey"],
          "additionalProperties": false,
          "properties": {"source": {"const": "templateInput"}, "inputKey": {"$ref": "#/$defs/identity"}}
        },
        {
          "type": "object",
          "required": ["source", "stepId", "portId"],
          "additionalProperties": false,
          "properties": {"source": {"const": "stepOutput"}, "stepId": {"$ref": "#/$defs/stepId"}, "portId": {"$ref": "#/$defs/identity"}}
        }
      ]
    },
    "code": {
      "type": "object",
      "required": [
        "language",
        "entrypoint",
        "source",
        "contractVersion",
        "outputs"
      ],
      "additionalProperties": false,
      "properties": {
        "language": {
          "const": "python"
        },
        "entrypoint": {
          "const": "main"
        },
        "source": {
          "type": "string",
          "pattern": "\\S"
        },
        "contractVersion": {
          "enum": [
            "1",
            "2"
          ]
        },
        "inputs": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identity"
          },
          "additionalProperties": {
            "$ref": "#/$defs/codeInput"
          }
        },
        "outputs": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identity"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/$defs/codeValueOutput"
              },
              {
                "$ref": "#/$defs/codeArtifactOutput"
              }
            ]
          },
          "minProperties": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "contractVersion": {
                "const": "2"
              }
            }
          },
          "then": {
            "required": [
              "inputs"
            ],
            "properties": {
              "inputs": {
                "minProperties": 1
              }
            }
          },
          "else": {
            "properties": {
              "inputs": {
                "maxProperties": 0
              }
            }
          }
        }
      ]
    },
    "codeInput": {
      "type": "object",
      "required": [
        "valueType",
        "required",
        "nullable"
      ],
      "additionalProperties": false,
      "properties": {
        "valueType": {
          "const": "string"
        },
        "required": {
          "const": true
        },
        "nullable": {
          "const": false
        },
        "schema": {
          "$ref": "#/$defs/codeStringSchema"
        }
      }
    },
    "codeStringSchema": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "string"
        },
        "minLength": {
          "type": "integer",
          "minimum": 0
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "codeValueOutput": {
      "type": "object",
      "required": [
        "kind",
        "valueType",
        "schema"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "value"
        },
        "valueType": {
          "enum": [
            "string",
            "number",
            "integer",
            "boolean",
            "array",
            "object"
          ]
        },
        "schema": {
          "type": "object"
        }
      }
    },
    "codeArtifactOutput": {
      "type": "object",
      "required": [
        "kind",
        "mimeType"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "artifact"
        },
        "mimeType": {
          "type": "string",
          "pattern": "^[^/\\s*]+/[^/\\s*]+$"
        }
      }
    },
    "loop": {
      "type": "object",
      "required": [
        "maxIterations",
        "deadlineSeconds",
        "body",
        "until",
        "state",
        "outputs"
      ],
      "additionalProperties": false,
      "properties": {
        "maxIterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "deadlineSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1800
        },
        "body": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/loopBodyStep"
          }
        },
        "until": {
          "$ref": "#/$defs/loopSelector"
        },
        "state": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identity"
          },
          "additionalProperties": {
            "$ref": "#/$defs/loopState"
          }
        },
        "outputs": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identity"
          },
          "additionalProperties": {
            "$ref": "#/$defs/loopSelector"
          },
          "minProperties": 1
        }
      }
    },
    "loopSelector": {
      "type": "object",
      "required": [
        "stepId",
        "portId"
      ],
      "additionalProperties": false,
      "properties": {
        "stepId": {
          "$ref": "#/$defs/stepId"
        },
        "portId": {
          "$ref": "#/$defs/identity"
        }
      }
    },
    "loopState": {
      "type": "object",
      "required": [
        "initial",
        "update"
      ],
      "additionalProperties": false,
      "properties": {
        "initial": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "source",
                "value"
              ],
              "additionalProperties": false,
              "properties": {
                "source": {
                  "const": "literal"
                },
                "value": {
                  "type": "string",
                  "pattern": "\\S"
                }
              }
            },
            {
              "$ref": "#/$defs/templateInputBinding"
            },
            {
              "$ref": "#/$defs/composeBinding"
            }
          ]
        },
        "update": {
          "$ref": "#/$defs/loopSelector"
        }
      }
    },
    "loopStateBinding": {
      "type": "object",
      "required": [
        "source",
        "inputKey"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "const": "loopState"
        },
        "inputKey": {
          "$ref": "#/$defs/identity"
        }
      }
    },
    "loopBodyStep": {
      "type": "object",
      "required": [
        "stepId",
        "displayName",
        "executionBinding"
      ],
      "additionalProperties": false,
      "properties": {
        "stepId": {
          "$ref": "#/$defs/stepId"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stepId"
          },
          "uniqueItems": true
        },
        "triggerPolicy": {
          "const": "require_all"
        },
        "executionBinding": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "kind",
                "profileId"
              ],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "capabilityProfile"
                },
                "profileId": {
                  "type": "string",
                  "minLength": 1
                },
                "profileRevision": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "required": [
                "kind",
                "profileId",
                "profileRevision"
              ],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "codeProfile"
                },
                "profileId": {
                  "type": "string",
                  "minLength": 1
                },
                "profileRevision": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "modelSelection": {
          "$ref": "#/$defs/modelSelection"
        },
        "inputBindings": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identity"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/$defs/inputBinding"
              },
              {
                "$ref": "#/$defs/loopStateBinding"
              }
            ]
          }
        },
        "code": {
          "$ref": "#/$defs/code"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "executionBinding": {
                "properties": {
                  "kind": {
                    "const": "codeProfile"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            },
            "required": [
              "executionBinding"
            ]
          },
          "then": {
            "properties": {
              "loop": false,
              "modelSelection": false
            },
            "required": [
              "code"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "executionBinding": {
                "properties": {
                  "kind": {
                    "const": "capabilityProfile"
                  }
                },
                "required": [
