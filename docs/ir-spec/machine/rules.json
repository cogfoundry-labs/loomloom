{
  "version": "template-spec-rules/v1",
  "rules": [
    {
      "id": "TS-VERSION-002",
      "scope": "template",
      "severity": "error",
      "enforcement": ["json_schema", "authoring_service"],
      "lifecycle": "new_authoring_only",
      "referenceId": "compatibility.write-version",
      "validExamples": ["examples/valid/multi-step-fixed-model.json"],
      "invalidExamples": ["examples/invalid/legacy-v1-shape.json"]
    },
    {
      "id": "TS-BINDING-002",
      "scope": "step",
      "severity": "error",
      "enforcement": ["core_validator", "authoring_service"],
      "referenceId": "ports-and-bindings.step-output",
      "validExamples": ["examples/valid/multi-step-fixed-model.json"],
      "invalidExamples": ["examples/invalid/step-output-without-dependency.json"]
    },
    {
      "id": "TS-PROFILE-002",
      "scope": "step",
      "severity": "error",
      "enforcement": ["core_validator", "authoring_service", "runtime_registry"],
      "referenceId": "profiles.model-selection",
      "validExamples": ["examples/valid/capability-profile.json"],
      "invalidExamples": ["examples/invalid/profile-without-model-selection.json"]
    }
  ]
}
