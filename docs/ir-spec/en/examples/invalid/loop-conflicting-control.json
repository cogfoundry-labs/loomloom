{
  "meta": {
    "name": "Whole-round accept, continue, and business rejection"
  },
  "templateInputs": {
    "request": {
      "kind": "value",
      "valueType": "string",
      "required": true,
      "blankPolicy": "error",
      "presentation": {
        "label": "Input text",
        "order": 1
      }
    }
  },
  "steps": [
    {
      "stepId": "stp_loop001",
      "displayName": "Business decision within three rounds",
      "executionBinding": {
        "kind": "loop"
      },
      "loop": {
        "maxIterations": 3,
        "deadlineSeconds": 180,
        "body": [
          {
            "stepId": "stp_judge01",
            "displayName": "Judge this round",
            "executionBinding": {
              "kind": "codeProfile"
            },
            "code": {
              "language": "python",
              "entrypoint": "main",
              "source": "def main(inputs):\n    n = int(inputs['round']) + 1\n    text = inputs['request'].strip()\n    action = 'reject' if text == 'REJECT' else ('accept' if n >= 2 else 'continue')\n    return {'action': action, 'feedback': str(n), 'copy': text}\n",
              "inputs": {
                "request": {
                  "valueType": "string",
                  "required": true,
                  "nullable": false,
                  "schema": {
                    "type": "string"
                  },
                  "kind": "value"
                },
                "round": {
                  "valueType": "string",
                  "required": true,
                  "nullable": false,
                  "schema": {
                    "type": "string"
                  },
                  "kind": "value"
                }
              },
              "outputs": {
                "action": {
                  "kind": "value",
                  "valueType": "string",
                  "schema": {
                    "type": "string",
                    "enum": [
                      "continue",
                      "accept",
                      "reject"
                    ]
                  }
                },
                "feedback": {
                  "kind": "value",
                  "valueType": "string",
                  "schema": {
                    "type": "string"
                  }
                },
                "copy": {
                  "kind": "value",
                  "valueType": "string",
                  "schema": {
                    "type": "string"
                  }
                }
              }
            },
            "inputBindings": {
              "request": {
                "source": "templateInput",
                "inputKey": "request"
              },
              "round": {
                "source": "loopState",
                "inputKey": "feedback"
              }
            }
          }
        ],
        "decision": {
          "stepId": "stp_judge01",
          "portId": "action"
        },
        "state": {
          "feedback": {
            "initial": {
              "source": "literal",
              "value": "0"
            },
            "update": {
              "stepId": "stp_judge01",
              "portId": "feedback"
            }
          }
        },
        "outputs": {
          "copy": {
            "stepId": "stp_judge01",
            "portId": "copy"
          }
        },
        "until": {
          "stepId": "stp_judge01",
          "portId": "action"
        }
      }
    }
  ],
  "workbook": {
    "sampleRows": [
      {
        "values": {
          "request": "Hello"
        }
      },
      {
        "values": {
          "request": "REJECT"
        }
      }
    ],
    "instructions": [
      "Hello is accepted in round two; REJECT is rejected in round one without publishing a candidate."
    ]
  }
}
