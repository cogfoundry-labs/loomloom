{
  "meta": {
    "name": "Accepted-round model text Artifact exports and merging"
  },
  "templateInputs": {
    "request": {
      "kind": "value",
      "valueType": "string",
      "required": true,
      "blankPolicy": "error",
      "presentation": {
        "label": "Generation request",
        "order": 1
      }
    }
  },
  "steps": [
    {
      "stepId": "stp_loop001",
      "displayName": "Rework for at most three rounds",
      "executionBinding": {
        "kind": "loop"
      },
      "loop": {
        "maxIterations": 3,
        "deadlineSeconds": 180,
        "body": [
          {
            "stepId": "stp_draft01",
            "displayName": "Generate candidate",
            "executionBinding": {
              "kind": "capabilityProfile",
              "profileId": "text.basic.openai-chat.v1"
            },
            "modelSelection": {
              "source": "fixed",
              "defaultModelId": "MODEL_ID_FROM_TARGET_AUTHORING_CONTEXT"
            },
            "inputBindings": {
              "prompt": {
                "source": "loopState",
                "inputKey": "feedback"
              }
            }
          },
          {
            "stepId": "stp_judge01",
            "displayName": "stp_judge01",
            "executionBinding": {
              "kind": "codeProfile"
            },
            "code": {
              "language": "python",
              "entrypoint": "main",
              "source": "def main(inputs):\n    copy = inputs[\"copy\"].strip()\n    passed = copy == \"HELLO\"\n    return {\"copy\": copy, \"passed\": passed, \"feedback\": \"Reply exactly HELLO\"}\n",
              "outputs": {
                "copy": {
                  "kind": "value",
                  "valueType": "string",
                  "schema": {
                    "type": "string"
                  }
                },
                "passed": {
                  "kind": "value",
                  "valueType": "boolean",
                  "schema": {
                    "type": "boolean"
                  }
                },
                "feedback": {
                  "kind": "value",
                  "valueType": "string",
                  "schema": {
                    "type": "string"
                  }
                }
              },
              "inputs": {
                "copy": {
                  "valueType": "string",
                  "required": true,
                  "nullable": false,
                  "schema": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "kind": "value"
                }
              }
            },
            "inputBindings": {
              "copy": {
                "source": "stepOutput",
                "stepId": "stp_draft01",
                "portId": "output"
              }
            },
            "dependsOn": [
              "stp_draft01"
            ]
          }
        ],
        "until": {
          "stepId": "stp_judge01",
          "portId": "passed"
        },
        "state": {
          "feedback": {
            "initial": {
              "source": "templateInput",
              "inputKey": "request"
            },
            "update": {
              "stepId": "stp_judge01",
              "portId": "feedback"
            }
          }
        },
        "outputs": {
          "copy": {
            "stepId": "stp_judge01",
            "portId": "copy"
          },
          "passed": {
            "stepId": "stp_judge01",
            "portId": "passed"
          },
          "candidate": {
            "stepId": "stp_draft01",
            "portId": "output"
          },
          "candidate2": {
            "stepId": "stp_draft01",
            "portId": "output"
          }
        }
      }
    },
    {
      "stepId": "stp_summary",
      "displayName": "Merge accepted-round text",
      "executionBinding": {
        "kind": "capabilityProfile",
        "profileId": "text.basic.openai-chat.v1"
      },
      "modelSelection": {
        "source": "fixed",
        "defaultModelId": "MODEL_ID_FROM_TARGET_AUTHORING_CONTEXT"
      },
      "inputBindings": {
        "prompt": {
          "source": "merge",
          "merge": {
            "policy": "concat_text",
            "missingSourcePolicy": "error",
            "sources": [
              {
                "source": "stepOutput",
                "stepId": "stp_loop001",
                "portId": "candidate"
              },
              {
                "source": "stepOutput",
                "stepId": "stp_loop001",
                "portId": "candidate2"
              }
            ]
          }
        }
      },
      "dependsOn": [
        "stp_loop001"
      ]
    }
  ],
  "workbook": {
    "sampleRows": [
      {
        "values": {
          "request": "Reply exactly HELLO"
        }
      }
    ]
  }
}
