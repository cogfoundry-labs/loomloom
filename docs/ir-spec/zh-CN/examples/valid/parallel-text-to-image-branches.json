{
  "meta": {"name": "书中场景并行配图"},
  "steps": [
    {
      "stepId": "stp_scenea",
      "displayName": "生成场景 A 提示词",
      "executionUnit": "text-generate",
      "instruction": "从书中选择一个有代表性的场景，输出一条可直接用于图片生成的中文提示词。",
      "defaultModelRef": {"modelKey": "google/gemini-2.5-flash"}
    },
    {
      "stepId": "stp_sceneb",
      "displayName": "生成场景 B 提示词",
      "executionUnit": "text-generate",
      "instruction": "从书中选择另一个不同的场景，输出一条可直接用于图片生成的中文提示词。",
      "defaultModelRef": {"modelKey": "google/gemini-2.5-flash"}
    },
    {
      "stepId": "stp_imagea",
      "displayName": "生成场景 A 图片",
      "executionUnit": "image-generate",
      "dependsOn": ["stp_scenea"],
      "upstreamBindings": [
        {
          "inputPort": "prompt",
          "sourceType": "step_output",
          "sourceStepId": "stp_scenea",
          "sourcePort": "output"
        }
      ],
      "defaultModelRef": {"modelKey": "image/model"}
    },
    {
      "stepId": "stp_imageb",
      "displayName": "生成场景 B 图片",
      "executionUnit": "image-generate",
      "dependsOn": ["stp_sceneb"],
      "upstreamBindings": [
        {
          "inputPort": "prompt",
          "sourceType": "step_output",
          "sourceStepId": "stp_sceneb",
          "sourcePort": "output"
        }
      ],
      "defaultModelRef": {"modelKey": "image/model"}
    }
  ],
  "inputSchema": {
    "fields": [
      {
        "key": "book_title",
        "label": "书名",
        "valueType": "string",
        "required": true
      }
    ]
  },
  "fieldBindings": [
    {
      "fieldKey": "book_title",
      "stepId": "stp_scenea",
      "paramKey": "prompt",
      "bindMode": "shared"
    },
    {
      "fieldKey": "book_title",
      "stepId": "stp_sceneb",
      "paramKey": "prompt",
      "bindMode": "shared"
    }
  ]
}
