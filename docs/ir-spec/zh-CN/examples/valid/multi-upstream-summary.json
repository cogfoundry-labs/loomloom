      "defaultModelRef": {"modelKey": "google/gemini-2.5-flash"}
    }
  ],
  "inputSchema": {"fields": [{"key": "document", "label": "待评审内容", "valueType": "string", "required": true}]},
  "fieldBindings": [
    {"fieldKey": "document", "stepId": "stp_product", "paramKey": "prompt", "bindMode": "shared"},
    {"fieldKey": "document", "stepId": "stp_engineer", "paramKey": "prompt", "bindMode": "shared"}
  ]
}
