{
  "meta": {"name": "Parallel Book Scene Illustrations"},
  "steps": [
    {
      "stepId": "stp_scenea",
      "displayName": "Write Scene A Prompt",
      "executionUnit": "text-generate",
      "instruction": "Choose one representative scene from the book and output one English image-generation prompt.",
      "defaultModelRef": {"modelKey": "google/gemini-2.5-flash"}
    },
    {
      "stepId": "stp_sceneb",
      "displayName": "Write Scene B Prompt",
      "executionUnit": "text-generate",
      "instruction": "Choose a different scene from the book and output one English image-generation prompt.",
      "defaultModelRef": {"modelKey": "google/gemini-2.5-flash"}
    },
    {
      "stepId": "stp_imagea",
      "displayName": "Generate Scene A Image",
      "executionUnit": "image-generate",
      "dependsOn": ["stp_scenea"],
      "upstreamBindings": [
        {
          "inputPort": "prompt",
          "sourceType": "step_output",
          "sourceStepId": "stp_scenea",
          "sourcePort": "output"
        }
      ],
      "defaultModelRef": {"modelKey": "image/model"}
    },
    {
      "stepId": "stp_imageb",
      "displayName": "Generate Scene B Image",
      "executionUnit": "image-generate",
      "dependsOn": ["stp_sceneb"],
      "upstreamBindings": [
        {
          "inputPort": "prompt",
          "sourceType": "step_output",
          "sourceStepId": "stp_sceneb",
          "sourcePort": "output"
        }
      ],
      "defaultModelRef": {"modelKey": "image/model"}
    }
  ],
  "inputSchema": {
    "fields": [
      {
        "key": "book_title",
        "label": "Book title",
        "valueType": "string",
        "required": true
      }
    ]
  },
  "fieldBindings": [
    {
      "fieldKey": "book_title",
      "stepId": "stp_scenea",
      "paramKey": "prompt",
      "bindMode": "shared"
    },
    {
      "fieldKey": "book_title",
      "stepId": "stp_sceneb",
      "paramKey": "prompt",
      "bindMode": "shared"
    }
  ]
}
