    {
      "id": "TS-IN-003",
      "scope": "template",
      "severity": "error",
      "enforcement": ["authoring_lint"],
      "referenceId": "ports-and-bindings.input-transport",
      "validExamples": ["examples/valid/uploaded-text-reference.json"],
      "invalidExamples": ["examples/invalid/uploaded-text-as-string.json"]
