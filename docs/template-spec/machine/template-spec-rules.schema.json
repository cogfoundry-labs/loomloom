{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loomloom.dev/schemas/template-spec-rules-v1.json",
  "type": "object",
  "required": ["version", "rules"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": "template-spec-rules/v1"},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "scope", "severity", "enforcement", "referenceId", "validExamples", "invalidExamples"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^TS-[A-Z]+-[0-9]{3}$"},
          "scope": {"enum": ["field", "step", "template", "runtime"]},
          "severity": {"enum": ["error", "warning"]},
          "enforcement": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["json_schema", "authoring_lint", "authoring_service", "publication_gate", "core_validator", "runtime_registry"]}
          },
          "lifecycle": {"enum": ["all_versions", "new_authoring_only", "runtime_compatibility"]},
          "referenceId": {"type": "string", "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$"},
          "validExamples": {"type": "array", "items": {"type": "string"}},
          "invalidExamples": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
